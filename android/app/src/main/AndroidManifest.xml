<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet access is used only after the user enables HTTPS cloud sync. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 短信权限：读取银行交易短信。短信是可选通道，不应把设备限定为必须有电话功能。 -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- 通知监听不需要 uses-permission，是通过 BIND_NOTIFICATION_LISTENER_SERVICE 在 Service 上声明 -->
    <!-- 前台服务：保证抓取行为稳定，不被系统杀 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+ 通知权限（让 app 自身能发通知，比如预算超支提醒） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 开机后按用户设置恢复常驻状态服务 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 应用内更新：下载已签名 APK 后拉起系统安装器。系统仍会逐次确认安装。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 语音记账：只在用户按住说话时录音，音频只在本机内存与本地模型里处理，不上传。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 没有麦克风的设备（平板/车机）仍可用通知、短信、OCR 记账，不因权限过滤掉安装。 -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- 扫码连接 Windows：只在用户点「扫码连接」时申请；相册解码不需要相机。 -->

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".BookkeepingApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BookkeepingApp">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BookkeepingApp"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 崩溃报告页：只在未捕获异常时拉起，独立主题避免依赖 Compose -->
        <activity
            android:name=".sync.PairingQrCaptureActivity"
            android:exported="false"
            android:theme="@style/Theme.QrScanner" />

        <activity
            android:name=".CrashActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light" />

        <!-- 通知监听服务：抓取支付宝/微信等的支付成功通知 -->
        <!-- BIND_NOTIFICATION_LISTENER_SERVICE 是系统级权限，只能由系统授予 -->
        <!-- 用户必须在「设置 - 通知 - 通知使用权」里手动勾选我们的应用 -->
        <service
            android:name=".notification.PaymentNotificationListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 前台保活服务：常驻运行状态通知，并提高 NotificationListener 在国产 ROM 上的存活率 -->
        <!-- 默认不启动，由用户在「设置」里开启 -->
        <service
            android:name=".notification.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="continuous on-device payment capture health monitor" />
        </service>

        <!-- 无障碍兜底服务：抓微信转账/红包、支付宝转账入账等通知抓不到的场景 -->
        <!-- 默认未启用，用户必须在系统「无障碍」里手动勾选才会生效 -->
        <service
            android:name=".notification.accessibility.AccessibilityCaptureService"
            android:exported="true"
            android:label="@string/accessibility_fallback_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 主页面识别服务：覆盖微信/支付宝付款、转账、红包、提现、退款和账单页面。
             OCR 是同一采集流程内的兜底，不是独立开关。 -->
        <!-- 用户可见名称必须是“清衡 · 页面识别”；兼容入口类名只是内部实现。 -->
        <service
            android:name="com.google.android.accessibility.selecttospeak.SelectToSpeakService"
            android:exported="true"
            android:label="@string/page_recognition_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_page_recognition_config" />
        </service>

        <!-- 短信广播接收器：抓取银行交易短信 -->
        <!-- SMS_RECEIVED 是允许的"豁免隐式广播"，可以静态注册 -->
        <receiver
            android:name=".notification.SmsBroadcastReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- 开机或应用更新后恢复常驻状态服务；仅在用户开启「常驻运行状态」时启动 -->
        <receiver
            android:name=".notification.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 应用内更新：只暴露 app 专属下载目录里的 APK 给系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>
    </application>

</manifest>