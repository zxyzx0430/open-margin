<?xml version="1.0" encoding="utf-8"?>
<!--
  Main page-recognition service. It covers WeChat and Alipay payment/bill
  cards; OCR is an internal fallback in the same pipeline, not a separate switch.
  - Only WeChat and Alipay are visible.
  - Screenshot access is used only after a supported payment page is recognized.
  - isAccessibilityTool=false is intentional for the compatibility entry and
    must be disclosed in the settings UI.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowsChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagIncludeNotImportantViews|flagRequestEnhancedWebAccessibility"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/page_recognition_service_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="200"
    android:packageNames="com.eg.android.AlipayGphone,com.tencent.mm" />
