# Example: paste INSIDE an existing HTTPS server { } block after replacing
# finance.example.com with your domain. Terminate TLS in the enclosing
# server block (not shown). Exposed local ports: API 8767, Wallos 18082.

location = /finance { return 308 /finance/; }

location /finance/ {
    proxy_pass http://127.0.0.1:8767/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Authorization $http_authorization;
    proxy_buffering off;
    proxy_read_timeout 180s;
    client_max_body_size 4m;
}

# Place BEFORE the broader /finance/ location.
location = /finance/wallos { return 308 /finance/wallos/; }
location ^~ /finance/wallos/ {
    proxy_pass http://127.0.0.1:18082/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Prefix /finance/wallos;
    proxy_cookie_path / /finance/wallos/;
    proxy_redirect default;
    client_max_body_size 8m;
}

# ChatGPT OAuth discovery aliases. Add to the same HTTPS server block.
location = /.well-known/oauth-protected-resource/finance/mcp {
    proxy_pass http://127.0.0.1:8767/.well-known/oauth-protected-resource;
    proxy_set_header Host $host;
}
location = /.well-known/oauth-authorization-server/finance/oauth {
    proxy_pass http://127.0.0.1:8767/oauth/.well-known/oauth-authorization-server;
    proxy_set_header Host $host;
}
